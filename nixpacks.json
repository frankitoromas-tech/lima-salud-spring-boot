{
  "phases": {
    "setup": {
      "nixPkgs": [
        "jdk17",
        "maven"
      ]
    },
    "build": {
      "cmds": [
        "mvn -B -DskipTests clean package"
      ]
    }
  },
  "start": {
    "cmd": "java -XX:+UseContainerSupport -Xmx384m -Dspring.profiles.active=prod -Dserver.port=$PORT -jar target/lima-salud-0.0.1-SNAPSHOT.jar"
  }
}
