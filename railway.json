{
  "$schema": "https://railway.com/railway.schema.json",
  "build": {
    "builder": "NIXPACKS",
    "buildCommand": "mvn -B -DskipTests clean package"
  },
  "deploy": {
    "startCommand": "java -XX:+UseContainerSupport -Xmx384m -Dspring.profiles.active=prod -Dserver.port=$PORT -jar target/lima-salud-0.0.1-SNAPSHOT.jar",
    "healthcheckPath": "/",
    "healthcheckTimeout": 300,
    "restartPolicyType": "ON_FAILURE",
    "restartPolicyMaxRetries": 5
  }
}
